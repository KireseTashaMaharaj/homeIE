              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "const today = new Date().toISOString().slice(0, 10);",
              "const past = pm.response.json()",
              "  .filter(b => b.status === \"confirmed\" && b.move_out_date < today)",
              "  .sort((a, b) => b.move_out_date.localeCompare(a.move_out_date));",
              "pm.test(\"has past confirmed stays\", () => pm.expect(past.length).to.be.above(1));",
              "if (past.length > 1) {",
              "  pm.collectionVariables.set(\"booking_r\", past[0].id);          // newest: used for the real review",
              "  pm.collectionVariables.set(\"review_listing_id\", past[0].listing_id);",
              "  pm.collectionVariables.set(\"booking_v\", past[past.length - 1].id); // oldest: only for error tests",
              "}"
            ]
          }
        }
      ]
